                    "{{1.email}}"
                ],
                "from": "BuiltWithSpring <hello@builtwithspring.com>",
                "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\"/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"/>\n  <title>Your itinerary is ready — BuiltWithSpring</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f7f5ff;font-family:Helvetica,Arial,sans-serif;color:#1a1640;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;\">\n  <!-- Preheader -->\n  <div style=\"display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1px;color:#f7f5ff;mso-hide:all;\">\n    {{1.firstName}}, your personalized itinerary is ready — view and download your PDF travel plan ✈️\n  </div>\n  <!-- Outer wrapper -->\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f7f5ff;\">\n    <tr>\n      <td align=\"center\" style=\"padding:32px 16px;\">\n        <!-- Card wrapper -->\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:560px;\">\n          <!-- Top accent bar -->\n          <tr>\n            <td style=\"background:#7c3aed;height:5px;font-size:0;line-height:0;border-radius:12px 12px 0 0;\">&nbsp;</td>\n          </tr>\n          <!-- Card body -->\n          <tr>\n            <td style=\"background:#ffffff;border:1px solid #e4e0f5;border-top:none;border-radius:0 0 12px 12px;\">\n              <!-- ── LOGO ── -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td align=\"center\" style=\"padding:28px 40px 20px;\">\n                    <img src=\"https://travel.builtwithspring.com/BWSLogo.png\" width=\"44\" height=\"44\" alt=\"BuiltWithSpring\" style=\"display:block;margin:0 auto 8px;border-radius:10px;\"/>\n                    <div style=\"font-size:12px;font-weight:bold;color:#6b5fa0;\">BuiltWithSpring &middot; AI-Powered Travel Planner</div>\n                  </td>\n                </tr>\n              </table>\n              <!-- Divider -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td style=\"padding:0 40px;\">\n                    <div style=\"border-top:1px solid #e4e0f5;font-size:0;line-height:0;\">&nbsp;</div>\n                  </td>\n                </tr>\n              </table>\n              <!-- ── HERO ── -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td align=\"center\" style=\"padding:32px 40px 0;\">\n                    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 auto 20px;\">\n                      <tr>\n                        <td width=\"64\" height=\"64\" align=\"center\" style=\"background-color:#7c3aed;border-radius:32px;font-size:28px;line-height:64px;color:#ffffff;\">\n                          &#10003;\n                        </td>\n                      </tr>\n                    </table>\n                    <div style=\"font-size:22px;font-weight:bold;color:#1a1640;line-height:1.3;margin-bottom:10px;\">\n                      {{1.firstName}}, your itinerary is ready &#127881;\n                    </div>\n                    <div style=\"font-size:14px;color:#6b5fa0;line-height:1.75;margin-bottom:28px;\">\n                      Your personalised AI travel plan has been built.<br/>View it anytime and download it as a PDF to take offline.\n                    </div>\n                    <!-- CTA button -->\n                    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 auto 8px;\">\n                      <tr>\n                        <td align=\"center\" style=\"background-color:#7c3aed;border-radius:10px;\">\n                          <a href=\"{{1.itineraryUrl}}\" target=\"_blank\" style=\"display:inline-block;padding:14px 36px;font-family:Helvetica,Arial,sans-serif;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;\">\n                            View my itinerary &#8594;\n                          </a>\n                        </td>\n                      </tr>\n                    </table>\n                    <div style=\"font-size:12px;color:#9b87d4;margin-bottom:28px;\">Opens in your browser — hit &ldquo;Download as PDF&rdquo; to save a copy</div>\n                  </td>\n                </tr>\n              </table>\n              <!-- ── WHAT'S INSIDE ── -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td style=\"padding:0 40px 24px;\">\n                    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f7f5ff;border:1px solid #e4e0f5;border-radius:10px;\">\n                      <tr>\n                        <td style=\"padding:20px 22px;\">\n                          <div style=\"font-size:13px;font-weight:bold;color:#1a1640;margin-bottom:14px;\">What's inside your itinerary</div>\n                          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                            <tr>\n                              <td style=\"padding:5px 0;font-size:13px;color:#1a1640;\">\n                                <span style=\"margin-right:10px;\">&#128197;</span>Day-by-day plan with morning, afternoon &amp; evening\n                              </td>\n                            </tr>\n                            <tr>\n                              <td style=\"padding:5px 0;font-size:13px;color:#1a1640;\">\n                                <span style=\"margin-right:10px;\">&#128142;</span>Hidden Finds — handpicked spots you wouldn't find on your own\n                              </td>\n                            </tr>\n                            <tr>\n                              <td style=\"padding:5px 0;font-size:13px;color:#1a1640;\">\n                                <span style=\"margin-right:10px;\">&#127836;</span>Restaurant guide with ratings &amp; Google Maps links\n                              </td>\n                            </tr>\n                            <tr>\n                              <td style=\"padding:5px 0;font-size:13px;color:#1a1640;\">\n                                <span style=\"margin-right:10px;\">&#127968;</span>Accommodation picks by neighbourhood\n                              </td>\n                            </tr>\n                            <tr>\n                              <td style=\"padding:5px 0;font-size:13px;color:#1a1640;\">\n                                <span style=\"margin-right:10px;\">&#128646;</span>Transport between cities with booking links\n                              </td>\n                            </tr>\n                            <tr>\n                              <td style=\"padding:5px 0;font-size:13px;color:#1a1640;\">\n                                <span style=\"margin-right:10px;\">&#128203;</span>Book Before You Go — sorted by urgency\n                              </td>\n                            </tr>\n                            <tr>\n                              <td style=\"padding:5px 0;font-size:13px;color:#1a1640;\">\n                                <span style=\"margin-right:10px;\">&#127759;</span>Practical info, visa, currency &amp; emergency contacts\n                              </td>\n                            </tr>\n                          </table>\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n              <!-- ── TIP BOX ── -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td style=\"padding:0 40px 28px;\">\n                    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ede9fe;border-radius:10px;\">\n                      <tr>\n                        <td width=\"4\" style=\"background-color:#7c3aed;border-radius:10px 0 0 10px;font-size:0;line-height:0;\">&nbsp;</td>\n                        <td style=\"padding:14px 16px;font-size:13px;color:#1a1640;line-height:1.6;\">\n                          <span style=\"font-weight:bold;\">&#128161; Pro tip:</span> Bookmark this link — you can come back to view and download your itinerary anytime, even if you lose the original.\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n              <!-- Divider -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td style=\"padding:0 40px;\">\n                    <div style=\"border-top:1px solid #e4e0f5;font-size:0;line-height:0;\">&nbsp;</div>\n                  </td>\n                </tr>\n              </table>\n              <!-- ── FOOTER ── -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td align=\"center\" style=\"padding:20px 40px 28px;\">\n                    <div style=\"font-size:13px;color:#6b5fa0;margin-bottom:14px;\">\n                      <a href=\"https://www.instagram.com/BuiltWithSpring\" target=\"_blank\" style=\"color:#7c3aed;text-decoration:none;font-weight:bold;\">&#128248; Instagram</a>\n                      &nbsp;&middot;&nbsp;\n                      <a href=\"https://www.linkedin.com/in/springlam/\" target=\"_blank\" style=\"color:#7c3aed;text-decoration:none;font-weight:bold;\">&#128188; LinkedIn</a>\n                      &nbsp;&middot;&nbsp;\n                      <a href=\"https://www.youtube.com/@BuiltWithSpring\" target=\"_blank\" style=\"color:#7c3aed;text-decoration:none;font-weight:bold;\">&#9654; YouTube</a>\n                    </div>\n                    <div style=\"font-size:12px;color:#6b5fa0;margin-bottom:5px;\">Questions? Reply to this email or reach us at</div>\n                    <a href=\"mailto:hello@builtwithspring.com\" style=\"font-size:12px;color:#7c3aed;font-weight:bold;text-decoration:none;\">hello@builtwithspring.com</a>\n                    <div style=\"font-size:11px;color:#9b87d4;margin-top:14px;\">\n                      &copy; 2026 BuiltWithSpring &middot;\n                      <a href=\"https://builtwithspring.com\" style=\"color:#9b87d4;text-decoration:none;\">builtwithspring.com</a>\n                    </div>\n                  </td>\n                </tr>\n              </table>\n              <!-- Bottom accent bar -->\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td style=\"background:#7c3aed;height:4px;font-size:0;line-height:0;border-radius:0 0 12px 12px;\">&nbsp;</td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
                "subject": "Your {{1.country}} itinerary is ready ✨",
